{
  "name": "autestme-functions",
  "version": "1.0.0",
  "description": "Server-side treasury signing relayer for Autestme reward claims",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "test": "firebase emulators:exec --only firestore \"vitest run\" --project autestme-test",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "ethers": "^6.13.4",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-functions-test": "^3.4.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
